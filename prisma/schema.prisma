// ============================================
// ASSIGNMENT (POST-HIRE)
// ============================================
// ─── STEP 1: REPLACE your Assignment model ───────────────────
// (only adds optional relation fields — zero schema-breaking changes)

model Assignment {
  assignment_id     String         @id @default(uuid())
  application_id    String         @unique
  start_date        DateTime
  end_date          DateTime?
  employment_type   EmploymentType
  workers_comp_code String?
  timesheets_enabled  Boolean  @default(true)
  workers_comp_codes Json?     // [{ code, description, pct }] — full multi-code array
  company_codes      Json?     // [{ code, description, allocation_pct }]

  // Rate snapshot at hire time (frozen from JobRate)
  hire_pay_rate     Decimal?  @db.Decimal(10, 2)
  hire_bill_rate    Decimal?  @db.Decimal(10, 2)
  hire_ot_pay_rate  Decimal?  @db.Decimal(10, 2)
  hire_ot_bill_rate Decimal?  @db.Decimal(10, 2)
  hire_markup       Decimal?  @db.Decimal(5, 2)
  hire_burden       Decimal?  @db.Decimal(5, 2)

  hired_notes   String?
  falloff       Boolean?  @default(false)
  extended      Boolean?  @default(false)

  // Existing relation
  application  Application  @relation(fields: [application_id], references: [application_id], onDelete: Cascade)

  created_at   DateTime       @default(now())

  timesheets   Timesheet[]
  time_entries TimeEntry[]
  invoices     Invoice[]
  payrolls     Payroll[]
  imports  TimesheetImport[]

  @@index([start_date])
  @@index([end_date])
  @@map("assignments")
}


// ─── STEP 2: ADD Timesheet model (NEW TABLE) ─────────────────

model Timesheet {
  timesheet_id         String          @id @default(uuid())
  assignment_id        String
  import_id            String?   // FK to TimesheetImport (nullable)


  // Always Mon 00:00:00 UTC → Sun 23:59:59 UTC
  week_start_date      DateTime
  week_end_date        DateTime

  status               TimesheetStatus @default(DRAFT)

  // Running totals — recalculated after every TimeEntry mutation
  total_regular_hours  Decimal         @default(0) @db.Decimal(7, 2)
  total_ot_hours       Decimal         @default(0) @db.Decimal(7, 2)
  total_hours          Decimal         @default(0) @db.Decimal(7, 2)

  // Billing snapshot written ONCE at approval time from JobRate.
  // Frozen so historical invoices never drift when rates change.
  bill_rate            Decimal?        @db.Decimal(10, 2)
  ot_bill_rate         Decimal?        @db.Decimal(10, 2)
  total_bill_amount    Decimal?        @db.Decimal(14, 2)
  pay_rate             Decimal?        @db.Decimal(10, 2)
  ot_pay_rate          Decimal?        @db.Decimal(10, 2)
  total_pay_amount     Decimal?        @db.Decimal(14, 2)

  // Workflow
  submitted_at         DateTime?
  reviewed_by_user_id  String?
  reviewed_at          DateTime?
  approved_at          DateTime?
  rejected_at          DateTime?
  rejection_reason     String?
  notes                String?
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  // Rate override — if set, these OVERRIDE the job's JobRate at
  // approval time. If null, the controller falls back to JobRate.
  custom_bill_rate          Decimal?  @db.Decimal(10, 2)
  custom_ot_bill_rate       Decimal?  @db.Decimal(10, 2)
  custom_pay_rate           Decimal?  @db.Decimal(10, 2)
  custom_ot_pay_rate        Decimal?  @db.Decimal(10, 2)
  custom_markup_percentage  Decimal?  @db.Decimal(5, 2)
  custom_overtime_rule      String?   // e.g. "DAILY_8", "WEEKLY_40", "CALIFORNIA"
  rate_override_reason      String?   // optional note why rates differ

  // QuickBooks
  qb_synced            Boolean         @default(false)
  qb_synced_at         DateTime?
  qb_timesheet_id      String?

  // Relations
  assignment           Assignment      @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade)
  reviewed_by          User?           @relation("TimesheetReviewer", fields: [reviewed_by_user_id], references: [user_id])
  time_entries         TimeEntry[]
  invoice              Invoice?
  payroll              Payroll?
  import               TimesheetImport? @relation(fields: [import_id], references: [import_id])


  @@unique([assignment_id, week_start_date])  // one timesheet per week per worker
  @@index([assignment_id])
  @@index([week_start_date])
  @@index([status])
  @@index([assignment_id, status])            // groupBy + filtered counts
  @@index([status, assignment_id])            // overview's approved-only aggregate
  @@map("timesheets")
  
}


// Tracks CSV/Excel import sessions so we can show history and link
// imported timesheets back to the batch that created them.

model TimesheetImport {
  import_id        String   @id @default(uuid())
  assignment_id    String
  imported_by      String   // user_id
  file_name        String
  file_type        String   // CSV | XLSX
  row_count        Int      @default(0)
  success_count    Int      @default(0)
  error_count      Int      @default(0)
  errors           Json?    // array of { row, message }
  status           String   @default("PROCESSING") // PROCESSING | DONE | FAILED
  created_at       DateTime @default(now())
  completed_at     DateTime?

  assignment       Assignment @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade)
  timesheets       Timesheet[]


  @@index([assignment_id])
  @@map("timesheet_imports")
  
}



// ─── STEP 3: ADD TimeEntry model (NEW TABLE — replaces old one) ─

model TimeEntry {
  time_entry_id   String     @id @default(uuid())
  timesheet_id    String
  assignment_id   String

  work_date       DateTime   // stored as date at 00:00:00 UTC

  // Worker fills in daily hours; weekly totals live on Timesheet
  regular_hours   Decimal    @default(0) @db.Decimal(5, 2)
  ot_hours        Decimal    @default(0) @db.Decimal(5, 2)
  total_hours     Decimal    @default(0) @db.Decimal(5, 2)

  break_minutes   Int?       @default(0)
  work_type       WorkType   @default(REGULAR)
  notes           String?
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  timesheet       Timesheet  @relation(fields: [timesheet_id], references: [timesheet_id], onDelete: Cascade)
  assignment      Assignment @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade)

  @@unique([timesheet_id, work_date])   // one entry per day per timesheet
  @@index([timesheet_id])
  @@index([assignment_id])
  @@index([work_date])
  @@map("time_entries")
}


// ─── STEP 4: ADD Invoice model (NEW TABLE) ───────────────────

model Invoice {
  invoice_id         String        @id @default(uuid())
  assignment_id      String
  timesheet_id       String        @unique   // 1 invoice per approved week

  invoice_number     String        @unique   // INV-2025-0042
  status             InvoiceStatus @default(DRAFT)

  invoice_date       DateTime      @default(now())
  due_date           DateTime
  paid_at            DateTime?

  // Denormalized snapshot for PDF stability
  regular_hours      Decimal       @db.Decimal(7, 2)
  ot_hours           Decimal       @default(0) @db.Decimal(7, 2)
  bill_rate          Decimal       @db.Decimal(10, 2)
  ot_bill_rate       Decimal?      @db.Decimal(10, 2)
  subtotal           Decimal       @db.Decimal(14, 2)
  tax_rate           Decimal       @default(0) @db.Decimal(6, 4)
  tax_amount         Decimal       @default(0) @db.Decimal(14, 2)
  total_amount       Decimal       @db.Decimal(14, 2)

  pdf_url            String?
  pdf_generated_at   DateTime?

  payment_method     String?
  payment_reference  String?

  qb_invoice_id      String?
  qb_synced          Boolean       @default(false)
  qb_synced_at       DateTime?
  qb_sync_error      String?

  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  assignment         Assignment    @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade)
  timesheet          Timesheet     @relation(fields: [timesheet_id], references: [timesheet_id], onDelete: Cascade)

  @@index([assignment_id])
  @@index([status])
  @@index([invoice_date])
  @@map("invoices")
}


// ─── STEP 5: REPLACE Payroll model ───────────────────────────
// timesheet_id is NULLABLE so existing Payroll rows don't break.
// After migration, backfill then optionally make it required.

model Payroll {
  payroll_id      String    @id @default(uuid())
  assignment_id   String
  timesheet_id    String?   @unique   // nullable = backward compatible
  pay_period      String              // "2025-W12"
  regular_hours   Decimal   @db.Decimal(7, 2)
  ot_hours        Decimal   @default(0) @db.Decimal(7, 2)
  pay_rate        Decimal   @db.Decimal(10, 2)
  ot_pay_rate     Decimal?  @db.Decimal(10, 2)
  gross_pay       Decimal   @db.Decimal(14, 2)
  net_pay         Decimal   @db.Decimal(14, 2)
  processed_at    DateTime  @default(now())

  qb_payroll_id   String?
  qb_synced       Boolean   @default(false)
  qb_synced_at    DateTime?

  assignment      Assignment  @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade)
  timesheet       Timesheet?  @relation(fields: [timesheet_id], references: [timesheet_id])

  @@index([assignment_id])
  @@map("payrolls")
}

model QBTokenStore {
  realm_id      String   @id
  access_token  String
  refresh_token String
  expires_at    DateTime
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("qb_token_store")
}

// ============================================
// APPLICANT COMMUNICATION LOG
// ============================================

model ApplicantCommunication {
  communication_id      String         @id @default(uuid())
  applicant_id          String

  communication_type    CommType       // EMAIL | CALL | SMS | NOTE
  direction             CommDirection? // OUTBOUND | INBOUND
  trigger               CommTrigger    // MANUAL | AUTOMATIC

  // ── Email-specific ──────────────────────────────────────────
  subject               String?
  body                  String?        // HTML or plain-text body
  from_address          String?
  to_address            String?
  email_message_id      String?        // nodemailer messageId for dedup

  // ── Call-specific ────────────────────────────────────────────
  call_duration_minutes Int?
  call_outcome          CallOutcome?   // ANSWERED | NO_ANSWER | VOICEMAIL | BUSY

  // ── Shared ───────────────────────────────────────────────────
  status                CommStatus     @default(LOGGED)
  notes                 String?        // HR internal notes
  sent_by_user_id       String?        // null = system-triggered
  application_id        String?        // optional application context
  metadata              Json?          // extra data (interview_id, round, etc.)

  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt

  applicant             Applicant      @relation(fields: [applicant_id], references: [applicant_id], onDelete: Cascade)
  sent_by               User?          @relation("CommSentBy", fields: [sent_by_user_id], references: [user_id])
  application           Application?   @relation(fields: [application_id], references: [application_id], onDelete: SetNull)

  @@index([applicant_id])
  @@index([applicant_id, communication_type])
  @@index([applicant_id, created_at])
  @@index([sent_by_user_id])
  @@map("applicant_communications")
}


