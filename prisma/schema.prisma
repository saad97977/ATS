// This is your Prisma schema file for PostgreSQL ATS Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE IDENTITY & ACCESS
// ============================================

model User {
  user_id       String     @id @default(uuid())
  name          String
  email         String     @unique
  password_hash String
  status        UserStatus @default(ACTIVE)
  is_admin      Boolean    @default(true)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  // ── Office-access flags (nullable = safe for existing rows) ──
  client_office_allow Boolean?  @default(true)
  back_office_allow   Boolean?  @default(true)
  front_office_allow  Boolean?  @default(true)

  // Relations
  user_role            UserRole?
  user_activity        UserActivity?
  created_tasks        Task[]                 @relation("TaskCreatedBy")
  assigned_tasks       Task[]                 @relation("TaskAssignedTo")
  contracts            Contract[]
  organization_users   OrganizationUser[]
  organization_docs    OrganizationDocument[]
  job_owners           JobOwner[]
  applicant_references ApplicantReferences[]
  credited_stages      PipelineStage[]        @relation("CreditUser")
  represented_stages   PipelineStage[]        @relation("RepresentativeUser")
  managed_jobs         Job[]                  @relation("JobManager")
  created_jobs         Job[]                  @relation("JobCreatedBy")
  created_organizations Organization[]        @relation("OrganizationCreatedBy")
  document_signatures  DocumentSignature[]
  reviewed_timesheets  Timesheet[] @relation("TimesheetReviewer")
  dashboard_preference DashboardPreference?
  profile     UserProfile?


  represented_organizations Organization[] @relation("OrganizationRepresentative")
  logged_activities OrganizationActivity[] @relation("ActivityLoggedBy")
  contact_previews ContactPreview[] @relation("PreviewLoggedBy")
  contact_representative OrganizationContact[] @relation("ContactRepresentative")
  created_templates JobTemplate[] @relation("TemplateCreatedBy")
  sent_communications ApplicantCommunication[] @relation("CommSentBy")

  @@index([email])
  @@map("users")
}


// ============================================
// NEW: USER PROFILE (extended identity & settings)
// ============================================

model UserProfile {
  profile_id          String    @id @default(uuid())
  user_id             String    @unique

  // Personal info
  first_name          String?
  last_name           String?
  middle_name         String?
  display_name        String?   // preferred display name (overrides name)
  avatar_url          String?   // Azure Blob URL
  avatar_blob_name    String?   // internal blob reference

  // Contact
  work_phone          String?
  mobile_phone        String?
  work_email          String?   // secondary work email if different from login
  personal_email      String?

  // Org placement
  title               String?   // "Senior Recruiter", "Account Manager"
  department          String?
  branch              String?
  division            OrgBranchDivision?
  office_location     String?

  // Employment details
  employee_id         String?   @unique   // internal HR/payroll ID
  hire_date           DateTime?
  employment_status   EmploymentStatus  @default(FULL_TIME)
  manager_user_id     String?   // self-referencing to another user

  // Regional/locale
  timezone            String?   // e.g. "America/Los_Angeles"
  language            String?   @default("en")

  // Social / bio
  linkedin_url        String?
  bio                 String?

  // Notification preferences (stored as flags)
  notify_email        Boolean   @default(true)
  notify_sms          Boolean   @default(false)
  notify_in_app       Boolean   @default(true)

  // Signature
  signature_image_url String?
  signature_blob_name String?

  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  user                User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("user_profiles")
}




model DashboardPreference {
  preference_id String   @id @default(uuid())
  user_id       String   @unique                  // one layout per user
  layout        Json                              // Array<{ key, position, size }>
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("dashboard_preferences")
}


model Role {
  role_id   String   @id @default(uuid())
  role_name RoleName

  // Relations
  user_roles UserRole[]

  @@map("roles")
}

model UserRole {
  user_role_id String @id @default(uuid())
  user_id      String @unique
  role_id      String

  // Relations
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [role_id])

  @@map("user_roles")
}

model UserActivity {
  activity_id   String   @id @default(uuid())
  user_id       String   @unique
  last_login_at DateTime?
  last_actions  Json?
  updated_at    DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("user_activities")
}



model Task {
  task_id             String    @id @default(uuid())
  user_id             String
  assigned_to_user_id String
  description         String
  status              String
  due_date            DateTime?
  created_at          DateTime  @default(now())

  // Relations
  created_by   User @relation("TaskCreatedBy", fields: [user_id], references: [user_id])
  assigned_to  User @relation("TaskAssignedTo", fields: [assigned_to_user_id], references: [user_id])

  @@index([assigned_to_user_id])
  @@map("tasks")
}

// ============================================
// ORGANIZATION & CLIENT CRM
// ============================================

model Organization {
  organization_id String             @id @default(uuid())
  name            String             @unique
  website         String?
  status          OrganizationStatus @default(ACTIVE)
  phone           String?
  created_by_user_id String
  created_at      DateTime           @default(now())
  last_updated_at DateTime?          @updatedAt   // automatically set whenever the row is updated
 
 
  fax                   String?
  zip                   String?
  industry              String?
  revenue               String?          // e.g. "$1M–$5M" — use String for flexibility
  employee_count        Int?
  last_contacted_at     DateTime?
  representative_id     String?          // FK → users.user_id
  branch_region         String?
  branch_name           String?
  default_ot_rule       String?
  contract_markup       Decimal?         @db.Decimal(5, 2)
  permanent_markup      Decimal?         @db.Decimal(5, 2)
  overview              String?
  custom_company_id     String?          @unique   // "Company ID" display field
  org_branch_division   OrgBranchDivision?


  // Relations
  addresses          OrganizationAddress[]
  contacts           OrganizationContact[]
  licenses           OrganizationLicense[]
  organization_users OrganizationUser[]
  contracts          Contract[]
  document_titles    OrganizationDocumentTitle[]
  documents          OrganizationDocument[]
  jobs               Job[]
  job_templates      JobTemplate[]
  company_offices    CompanyOffice[]
  created_by         User @relation("OrganizationCreatedBy", fields: [created_by_user_id], references: [user_id])

  representative        User?            @relation("OrganizationRepresentative", fields: [representative_id], references: [user_id])
  activities OrganizationActivity[]



  @@index([created_by_user_id])
  @@map("organizations")
}

model OrganizationAddress {
  organization_address_id String      @id @default(uuid())
  organization_id         String
  address_type            AddressType
  address1                String
  address2                String?
  city                    String
  state                   String
  zip                     String
  phone                   String?

  // Relations
  organization Organization @relation(fields: [organization_id], references: [organization_id], onDelete: Cascade)

  @@index([organization_id])
  @@map("organization_addresses")
}

model OrganizationContact {
  organization_contact_id String      @id @default(uuid())
  organization_id         String
  name                    String
  email                   String
  phone                   String
  contact_type            ContactType

  first_name        String?
  last_name         String?
  contact_title     String?          // "Contact Title" (job title of the contact)
  address           String?
  mobile_phone      String?
  fax               String?
  city              String?
  state             String?
  zip               String?
  division          String?
  department        String?
  title             String?
  representative_id String?
  last_updated_at   DateTime?        @updatedAt
  last_contacted_at DateTime?
  created_at        DateTime         @default(now())


  // Relations
  organization Organization @relation(fields: [organization_id], references: [organization_id], onDelete: Cascade)

  representative    User?            @relation("ContactRepresentative", fields: [representative_id], references: [user_id])

  @@index([organization_id])
  @@map("organization_contacts")
}

model ContactPreview {
  preview_id          String              @id @default(uuid())
  organization_user_id String?
  user_id             String
  type                ContactPreviewType
  notes               String?
  date                DateTime            @default(now())
  job_id              String?

  organization_user   OrganizationUser?   @relation(fields: [organization_user_id], references: [organization_user_id], onDelete: Cascade)
  user                User                @relation("PreviewLoggedBy", fields: [user_id], references: [user_id])
  job                 Job?                @relation(fields: [job_id], references: [job_id])

  @@index([organization_user_id])
  @@index([job_id])
  @@map("contact_previews")
}



model OrganizationLicense {
  organization_license_id String    @id @default(uuid())
  organization_id         String
  license_name            String    @unique
  license_document        String
  expiration_date         DateTime?

  // Relations
  organization Organization @relation(fields: [organization_id], references: [organization_id], onDelete: Cascade)

  @@index([organization_id])
  @@map("organization_licenses")
}


model OrganizationUser {
  organization_user_id String  @id @default(uuid())
  organization_id      String
  user_id              String
  division             String?
  department           String?
  title                String?
  work_phone           String?

  // Relations
  organization Organization @relation(fields: [organization_id], references: [organization_id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  contact_previews ContactPreview[]
  contact_jobs     ContactJob[]

  @@index([organization_id])
  @@index([user_id])
  @@map("organization_users")
}


model OrganizationActivity {
  activity_id     String              @id @default(uuid())
  organization_id String
  logged_by_user_id String
  activity_type   OrgActivityType
  details         String?
  created_at      DateTime            @default(now())

  organization    Organization        @relation(fields: [organization_id], references: [organization_id], onDelete: Cascade)
  logged_by       User                @relation("ActivityLoggedBy", fields: [logged_by_user_id], references: [user_id])

  @@index([organization_id])
  @@index([logged_by_user_id])
  @@map("organization_activities")
}


model ContactJob {
  contact_job_id      String              @id @default(uuid())
  organization_user_id String?
  job_id              String

  organization_user   OrganizationUser?   @relation(fields: [organization_user_id], references: [organization_user_id], onDelete: Cascade)
  job                 Job                 @relation(fields: [job_id], references: [job_id], onDelete: Cascade)

  @@unique([organization_user_id, job_id])
  @@index([organization_user_id])
  @@index([job_id])
  @@map("contact_jobs")
}

// ============================================
// CONTRACTS & DOCUMENTS
// ============================================

model Contract {
  contract_id                String    @id @default(uuid())
  organization_id            String
  user_id                    String
  contract_name              String
  status                     String
  is_organization_contractor Boolean
  sent_status                String?
  signed_status              String?
  signed_at                  DateTime?
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt

  // Relations
  organization Organization @relation(fields: [organization_id], references: [organization_id])
  user         User         @relation(fields: [user_id], references: [user_id])

  @@index([organization_id])
  @@index([user_id])
  @@map("contracts")
}



model OrganizationDocumentTitle {
  document_title_id String @id @default(uuid())
  organization_id   String 
  document_title    String

  // Relations
  organization Organization @relation(fields: [organization_id], references: [organization_id], onDelete: Cascade)
  documents    OrganizationDocument[]

  @@index([organization_id])
  @@map("organization_document_titles")
}



model OrganizationDocument {
  document_id       String    @id @default(uuid())
  document_title_id String
  organization_id   String
  document_type     String
  document_name     String    
  user_id           String
  file              String
  privacy           Privacy
  expiration_date   DateTime?
  expiration_reason String?
  upload_date       DateTime  @default(now())

  // Relations
  organization Organization @relation(fields: [organization_id], references: [organization_id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [user_id])
  title        OrganizationDocumentTitle @relation(fields: [document_title_id], references: [document_title_id], onDelete: Cascade)
  document_signatures DocumentSignature[]
  signature_requests  SignatureRequest[]

  @@index([organization_id])
  @@index([user_id])
  @@index([document_title_id])
  @@map("organization_documents")
}


model DocumentSignature {
  signature_id        String   @id @default(uuid())
  document_id         String
  user_id             String
  signer_name         String
  signer_email        String
  signature_image_url String
  signature_type      String   // DRAWN, TYPED, UPLOADED
  signed_at           DateTime @default(now())
  ip_address          String?
  user_agent          String?
  verification_hash   String
  position            String?  // JSON
  status              String   @default("COMPLETED") // COMPLETED | REJECTED
  is_verified         Boolean  @default(false)
  rejected_at         DateTime?   // ← NEW (nullable, safe)
  rejection_reason    String?     // ← NEW (nullable, safe)
  rejected_by         String?     // ← NEW (user_id of rejector, nullable)

  document            OrganizationDocument @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  user                User @relation(fields: [user_id], references: [user_id])

  @@index([document_id])
  @@index([user_id])
}


model SignatureRequest {
  request_id       String   @id @default(uuid())
  document_id      String
  recipient_email  String
  recipient_name   String
  message          String?
  status           String   @default("PENDING")
  request_token    String   @unique
  expires_at       DateTime
  created_at       DateTime @default(now())
  completed_at     DateTime?
  
  document         OrganizationDocument @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  
  @@index([document_id])
  @@index([request_token])
}



// ============================================
// JOB MANAGEMENT
// ============================================


model Job {
  job_id          String    @id @default(uuid())
  organization_id String
  manager_id      String?
  job_title       String
  status          JobStatus @default(DRAFT)
  job_type        JobType
  location        String
  days_active     Int?
  days_inactive   Int?
  approved        Boolean   @default(false)
  start_date      DateTime?
  end_date        DateTime?
  created_at      DateTime  @default(now())
  created_by_user_id String
  max_positions     Int?
  open_positions    Int?
  company_office_id String?
  resume_required   Boolean?   @default(false)
  interview_Round1  Boolean?   @default(true)
  interview_Round2  Boolean?   @default(false)
  interview_rounds Int? @default(1)

  // New fields
  open_date             DateTime?
  contract_duration     Int?           // in days or weeks (integer)
  address               String?        // full street address
  city                  String?        // split from location
  state                 String?        // split from location
  manager_last_contacted DateTime?
  job_branch            JobBranch?        
  job_category          JobCategory?   
  custom_job_id         String?        // Custom Job ID
  po_number             String?        // PO #
  po_amount             Decimal?       @db.Decimal(14, 2)  // PO Amount
  withhold_emails       Boolean?       @default(false)
  invoice_with_hours    Boolean?       @default(false)
  time_capture          TimeCaptureType @default(TIMESHEET)
  pay_period            PayPeriodType   @default(WEEKLY)
  week_duration         WeekDurationType @default(MON_SUN)
  rate_type             RateType        @default(HOURLY)
  paycom_position       String?
  workers_comp_codes    Json?          // [{ code, description, pct }]

  // Relations
  organization  Organization   @relation(fields: [organization_id], references: [organization_id])
  manager       User?          @relation("JobManager", fields: [manager_id], references: [user_id])
  created_by    User         @relation("JobCreatedBy", fields: [created_by_user_id], references: [user_id])
  job_detail    JobDetail?
  job_owners    JobOwner[]
  job_notes     JobNote[]
  job_postings  JobPosting[]
  job_rates     JobRate[]
  applications  Application[]
  company_office  CompanyOffice? @relation(fields: [company_office_id], references: [company_office_id])

  contact_previews ContactPreview[]
  contact_jobs ContactJob[]
  job_templates JobTemplate[]

  @@index([created_by_user_id])
  @@index([organization_id])
  @@index([manager_id])
  @@index([status])
  @@map("jobs")
}





model JobDetail {
  job_detail_id String @id @default(uuid())
  job_id        String @unique
  description   String
  skills        Json?

  // Relations
  job Job @relation(fields: [job_id], references: [job_id], onDelete: Cascade)

  @@map("job_details")
}

model CompanyOffice {
  company_office_id String  @id @default(uuid())
  organization_id   String
  office_name       String  
  city              String
  state             String
  country           String
  type              OfficeType
  address           String
  is_primary        Boolean @default(false)

  // Relations
  organization Organization @relation(fields: [organization_id], references: [organization_id], onDelete: Cascade)
  jobs         Job[]        // Add this reverse relation


  @@index([organization_id])
  @@map("company_offices")
}

model JobOwner {
  job_owner_id String    @id @default(uuid())
  job_id       String
  user_id      String
  role_type    OwnerRole

  // Relations
  job  Job  @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [user_id])

  @@index([job_id])
  @@index([user_id])
  @@map("job_owners")
}

model JobNote {
  job_note_id String   @id @default(uuid())
  job_id      String
  note        String
  created_at  DateTime @default(now())

  // Relations
  job Job @relation(fields: [job_id], references: [job_id], onDelete: Cascade)

  @@index([job_id])
  @@map("job_notes")
}

model JobPosting {
  job_posting_id      String  @id @default(uuid())
  job_id              String
  channel             String
  external_posting_id String
  status              String

  // Relations
  job Job @relation(fields: [job_id], references: [job_id], onDelete: Cascade)

  @@index([job_id])
  @@map("job_postings")
}


model JobTemplate {
  template_id        String    @id @default(uuid())
  job_id             String    // FK → the source job (data lives there)
  organization_id    String?   // denormalized for fast filtering (from job)
  created_by_user_id String
  name               String    // "Warehouse Associate - Standard"
  description        String?
  is_active          Boolean   @default(true)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  // ← THE KEY CHANGE: frozen snapshot of exactly what the user chose to save
  snapshot           Json      // JobSnapshot shape (see below)
  sections_included  Json      // { core, detail, rates, owners, notes } booleans

  job          Job           @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  organization Organization? @relation(fields: [organization_id], references: [organization_id], onDelete: SetNull)
  created_by   User          @relation("TemplateCreatedBy", fields: [created_by_user_id], references: [user_id])

  @@index([job_id])
  @@index([organization_id])
  @@index([created_by_user_id])
  @@map("job_templates")
}

// ============================================
// PAY & BILL
// ============================================

model JobRate {
  job_rate_id       String   @id @default(uuid())
  job_id            String
  pay_rate          Decimal?  @db.Decimal(10, 2)
  bill_rate         Decimal  @db.Decimal(10, 2)
  markup_percentage Decimal?  @db.Decimal(5, 2)
  overtime_rule     String?
  hours             Int
  ot_pay_rate       Decimal? @db.Decimal(10, 2)
  ot_bill_rate      Decimal? @db.Decimal(10, 2)

  // New fields
  min_bill_rate         Decimal?  @db.Decimal(10, 2)
  max_bill_rate         Decimal?  @db.Decimal(10, 2)
  target_bill_rate      Decimal?  @db.Decimal(10, 2)
  min_pay_rate          Decimal?  @db.Decimal(10, 2)
  max_pay_rate          Decimal?  @db.Decimal(10, 2)
  target_pay_rate       Decimal?  @db.Decimal(10, 2)
  burden                Decimal?  @db.Decimal(5, 2)   // 15.00
  discounts             Decimal?  @db.Decimal(5, 2)   // 0.00
  gross_margin_hourly   Decimal?  @db.Decimal(10, 2)  // Hourly/Daily GM
  estimated_hours       Int?                           // 155672
  estimated_gp          Decimal?  @db.Decimal(14, 2)  // 832,456.02
  dt_markup_percentage  Decimal?  @db.Decimal(5, 2)   // DT Mark-up %
  dt_bill_rate          Decimal?  @db.Decimal(10, 2)  // Doubletime Bill
  dt_pay_rate           Decimal?  @db.Decimal(10, 2)  // Doubletime Pay
  expenses              String?                        // None / value



  // Relations
  job Job @relation(fields: [job_id], references: [job_id], onDelete: Cascade)

  @@index([job_id])
  @@map("job_rates")
}

// ============================================
// TALENT & APPLICANTS
// ============================================

// ============================================
// APPLICANT — extended profile fields
// ============================================

model Applicant {
  applicant_id    String          @id @default(uuid())
  first_name      String?         // ← NEW (split from full_name)
  last_name       String?         // ← NEW
  full_name       String          // keep for backward compat
  headline        String?         // ← NEW
  status          ApplicantStatus @default(APPLIED)
  comp_code_last  String?
  last_active_at  DateTime?
  created_at      DateTime        @default(now())

  // NEW profile-level fields
  home_office          String?    // e.g. "SMS Staffing Solutions-United States"
  geo_code             String?
  school_district      String?
  source               String?    // applicant-level source (independent of application)
  is_us_citizen        Boolean?
  employment_type_pref EmploymentTypePref?  // ← NEW enum (see below)
  first_impression     ImpressionGrade?     // ← NEW enum
  add_to_hotlist       Boolean?   @default(false)
  notes                String?    // free text notes

  text_consent           String?   // "No Response" | "Yes" | "No"
  communication_preference String? // "Email, Text"
  is_optout              Boolean?  @default(false)
  is_private             Boolean?  @default(false)
  office_name            String?   // "MCL JASCO GOC"
  office_division        OrgBranchDivision?   // "SMS Staffing Solutions"


  // Relations
  contact              ApplicantContact?
  demographic          ApplicantDemographic?
  documents            ApplicantDocument[]
  social_profiles      ApplicantSocialProfiles[]
  references           ApplicantReferences[]
  work_history         ApplicantWorkHistory[]
  education            ApplicantEducation[]         // ← NEW
  classification       ApplicantClassification?     // ← NEW
  applicant_tags       ApplicantTag[]               // ← NEW (rated tags)
  applications         Application[]
  communications       ApplicantCommunication[]

  @@map("applicants")
}



// ============================================
// APPLICANT — extended contact info
// ============================================

model ApplicantContact {
  applicant_contact_id String  @id @default(uuid())
  applicant_id         String  @unique
  email                String
  email2               String?   // ← NEW: secondary email
  phone                String    // mobile (primary)
  work_phone           String?   // ← NEW
  home_phone           String?   // ← NEW
  address              String?
  city                 String?
  state                String?   // ← NEW
  zip                  String?   // ← NEW
  country              String?   // ← NEW

  applicant Applicant @relation(fields: [applicant_id], references: [applicant_id], onDelete: Cascade)

  @@map("applicant_contacts")
}



// ============================================
// NEW: Education history
// ============================================

model ApplicantEducation {
  education_id  String    @id @default(uuid())
  applicant_id  String
  school        String
  degree        String?
  field         String?
  from_date     DateTime?
  to_date       DateTime?

  applicant Applicant @relation(fields: [applicant_id], references: [applicant_id], onDelete: Cascade)

  @@index([applicant_id])
  @@map("applicant_education")
}





model ApplicantDemographic {
  applicant_demo_id    String    @id @default(uuid())
  applicant_id         String    @unique
  birth_date           DateTime?
  gender               String?
  race                 String?
  disability           String?
  work_authorization   String?
  authorization_expiry DateTime?
  ssn_encrypted  String?   // AES-256-CBC encrypted SSN hex string
  tax_info       Json?     // { filing_status, additional_withholding, exempt_from_federal,
                           //   exempt_from_state, work_state, resident_state }


  // Relations
  applicant Applicant @relation(fields: [applicant_id], references: [applicant_id], onDelete: Cascade)

  @@map("applicant_demographics")
}

// ============================================
